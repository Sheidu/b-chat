PORT=3000
BCRYPT_SALT_ROUNDS=12
DB_FILE_MUST_EXIST=0
NODE_ENV=development
SQL_VERBOSE=0

# Compliance / auth policy
REGISTRATION_POLICY=strict_ru_email
TERMS_VERSION=2026-03-31
USER_AGREEMENT_URL=https://direct.yandex.ru/base/articles/polzovatelskoe-soglashenie

# JWT auth
JWT_SECRET=change-me-in-production-jwt-secret
JWT_EXPIRES_IN=7d

# Auth abuse controls
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=12

# User deletion behavior
HARD_DELETE_USERS=0

# Transport / runtime hardening
CORS_ALLOWLIST=
SESSION_COOKIE_SECURE=auto

# Message encryption
MESSAGE_ENCRYPTION_KEY=
MESSAGE_ENCRYPTION_PREVIOUS_KEYS=

# Notifications
MAIL_SENDER=noreply@family-chat.local
EMAIL_QUEUE_POLL_MS=15000
