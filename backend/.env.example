PORT=3000
BCRYPT_SALT_ROUNDS=12
DB_FILE_MUST_EXIST=0
NODE_ENV=development
SQL_VERBOSE=0

# Compliance / auth policy
REGISTRATION_POLICY=strict_ru_email
TERMS_VERSION=2026-03-31
USER_AGREEMENT_URL=https://direct.yandex.ru/base/articles/polzovatelskoe-soglashenie

# JWT auth
JWT_SECRET=change-me-in-production-jwt-secret
JWT_EXPIRES_IN=7d

# HTTP rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ATTEMPTS=12

# User deletion behavior
HARD_DELETE_USERS=0

# Transport / runtime hardening
# Empty in development allows localhost/127.0.0.1 browser origins on any port.
# Production requires explicit trusted origins, e.g. https://chat.example.com
CORS_ALLOWLIST=
SESSION_COOKIE_SECURE=auto

# Message encryption
MESSAGE_ENCRYPTION_KEY=
MESSAGE_ENCRYPTION_PREVIOUS_KEYS=

# Notifications
MAIL_SENDER=noreply@family-chat.local
EMAIL_PROVIDER=log
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
EMAIL_QUEUE_POLL_MS=15000
